/* The viewer's stylesheet, on top of Qt's Fusion style and a neutral palette.
   The chrome is neutral grey; the accent marks only selection and focus.
   ${name} is replaced by the theme's colour of that name, or the accent's:
   window, field, bar, border, text, muted, faint, hover, danger, accent,
   accent_light, accent_soft, accent_faint, on_accent; ${icons} is the folder
   of the icons tinted for the theme. */

* {
  font-size: 13px;
  selection-background-color: ${accent_soft};
  selection-color: ${text};
}

QWidget {
  color: ${text};
  background-color: ${window};
}

QMainWindow::separator,
QSplitter::handle {
  background-color: ${border};
}

QSplitter::handle:horizontal {
  width: 1px;
}

QSplitter::handle:vertical {
  height: 1px;
}

QLabel {
  background-color: transparent;
  border: none;
}

QToolTip {
  color: ${text};
  background-color: ${field};
  border: 1px solid ${border};
  border-radius: 4px;
  padding: 4px 6px;
}

/* ---- Menus ---- */

QMenuBar {
  background-color: ${bar};
  border-bottom: 1px solid ${border};
}

QMenuBar::item {
  padding: 4px 10px;
  background-color: transparent;
  color: ${text};
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
  background-color: ${accent_soft};
  border-radius: 4px;
}

QMenu {
  background-color: ${field};
  border: 1px solid ${border};
  border-radius: 6px;
  padding: 4px;
}

QMenu::item {
  color: ${text};
  background-color: transparent;
  padding: 5px 24px 5px 24px;
  border-radius: 4px;
  height: 18px;
}

QMenu::item:selected {
  background-color: ${accent_soft};
  color: ${text};
}

QMenu::item:disabled {
  color: ${faint};
}

QMenu::separator {
  height: 1px;
  background-color: ${border};
  margin: 4px 8px;
}

/* ---- The views: a thin frame each, half the gap between two views ---- */

QFrame#viewPanel {
  border: 1px solid ${border};
}

QFrame#viewPanel[selected="true"] {
  border: 1px solid ${accent};
}

/* ---- Header, toolbar and docked panels ---- */

QToolBar#headerBar,
QToolBar#toolsBar {
  background-color: ${bar};
  border: none;
  border-bottom: 1px solid ${border};
  padding: 0px;
  spacing: 0px;
}

QWidget#header,
QWidget#viewToolbar {
  background-color: ${bar};
}

QLabel#datasetName {
  color: ${text};
  font-weight: bold;
}

QToolButton#workspaceSwitch {
  color: ${muted};
  background-color: ${field};
  border: 1px solid ${border};
  padding: 4px 14px;
}

QToolButton#workspaceSwitch:checked {
  color: ${text};
  background-color: ${accent_soft};
  font-weight: bold;
}

QToolButton#toolButton,
QToolButton#headerIcon {
  color: ${text};
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 5px;
  padding: 3px 8px;
}

QToolButton#toolButton:hover,
QToolButton#headerIcon:hover {
  background-color: ${hover};
}

QToolButton#toolButton:checked {
  background-color: ${accent_soft};
  border: 1px solid ${accent};
}

QTabWidget#inspector::pane {
  border: none;
  border-top: 1px solid ${border};
}

QTabWidget#inspector QTabBar::tab {
  color: ${muted};
  background-color: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 6px 12px;
}

QTabWidget#inspector QTabBar::tab:selected {
  color: ${text};
  border-bottom: 2px solid ${accent};
}

ads--CDockContainerWidget,
ads--CDockAreaWidget,
ads--CDockWidget {
  background-color: ${window};
  border: none;
}

QScrollArea#dockWidgetScrollArea {
  border: none;
  padding: 0px;
}

ads--CDockSplitter::handle {
  background-color: ${border};
}

ads--CDockSplitter::handle:horizontal {
  width: 1px;
}

ads--CDockSplitter::handle:vertical {
  height: 1px;
}

ads--CDockAreaTitleBar {
  background-color: ${bar};
  border-bottom: 1px solid ${border};
  min-height: 28px;
  max-height: 28px;
}

ads--CDockWidgetTab {
  background-color: transparent;
  border: none;
  padding: 0px 6px;
}

ads--CDockWidgetTab QLabel {
  color: ${muted};
  font-weight: bold;
}

ads--CDockWidgetTab[activeTab="true"] QLabel {
  color: ${text};
}

ads--CTitleBarButton {
  background-color: transparent;
  border: none;
  border-radius: 4px;
  padding: 3px;
  margin: 0px 2px;
  qproperty-iconSize: 14px 14px;
}

ads--CTitleBarButton:hover {
  background-color: ${hover};
}

ads--CTitleBarButton:pressed {
  background-color: ${border};
}

#dockAreaCloseButton,
#tabCloseButton {
  qproperty-icon: url("${icons}/close.svg");
}

ads--CResizeHandle {
  background-color: ${border};
}

QLabel#panelHint {
  color: ${muted};
  padding: 12px 14px;
}

/* ---- The scene tree ---- */

QTreeView#sceneTree {
  background-color: ${window};
  border: none;
  padding: 4px 0px;
  outline: 0;
  show-decoration-selected: 1;
  selection-background-color: transparent;
}

QTreeView#sceneTree::item {
  height: 26px;
  padding: 0px 2px;
  border: none;
  color: ${text};
}

QTreeView#sceneTree::item:hover {
  background-color: ${hover};
}

QTreeView#sceneTree::item:selected {
  background-color: ${accent_soft};
  color: ${text};
}

QTreeView#sceneTree::branch {
  background-color: transparent;
  border-image: none;
  image: none;
}

QTreeView#sceneTree::branch:has-children:closed {
  image: url("${icons}/chevron-right.svg");
}

QTreeView#sceneTree::branch:has-children:open {
  image: url("${icons}/chevron-down.svg");
}

/* ---- The inspector's and the settings' forms of fields ---- */

QScrollArea#options,
QScrollArea#settings {
  border: none;
  background-color: ${window};
}

QWidget#optionsForm,
QWidget#settingsForm {
  background-color: ${window};
}

QLabel#formTitle {
  color: ${text};
  font-weight: bold;
  font-size: 14px;
  padding: 2px 0px 6px 0px;
}

QToolButton#optionGroup {
  color: ${text};
  font-weight: bold;
  border: none;
  border-bottom: 1px solid ${border};
  background-color: transparent;
  margin: 0px;
  padding: 6px 0px 4px 0px;
  text-align: left;
}

QToolButton#optionGroup:checked,
QToolButton#optionGroup:hover {
  background-color: transparent;
}

QLabel#formSection {
  color: ${text};
  font-weight: bold;
  padding: 10px 0px 2px 0px;
}

QLabel#fieldError {
  color: ${danger};
}

QLineEdit,
QAbstractSpinBox {
  color: ${text};
  background-color: ${field};
  border: 1px solid ${border};
  border-radius: 4px;
  padding: 2px 6px;
  min-height: 20px;
  height: 20px;
}

QLineEdit:hover,
QAbstractSpinBox:hover {
  border-color: ${muted};
}

QLineEdit:focus,
QAbstractSpinBox:focus {
  border-color: ${accent};
}

QLineEdit:disabled,
QAbstractSpinBox:disabled,
QComboBox:disabled,
QPushButton:disabled,
QToolButton#menuButton:disabled {
  color: ${faint};
  background-color: ${window};
  border-color: ${border};
}

QLabel:disabled,
QCheckBox:disabled,
QRadioButton:disabled {
  color: ${faint};
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
  width: 16px;
  border: none;
  background-color: transparent;
}

QAbstractSpinBox::up-arrow {
  image: url("${icons}/chevron-up.svg");
  width: 12px;
  height: 12px;
}

QAbstractSpinBox::down-arrow {
  image: url("${icons}/chevron-down.svg");
  width: 12px;
  height: 12px;
}

QComboBox {
  color: ${text};
  background-color: ${field};
  border: 1px solid ${border};
  border-radius: 4px;
  padding: 2px 6px;
  min-height: 20px;
  height: 20px;
}

QComboBox:hover {
  border-color: ${muted};
}

QComboBox:focus,
QComboBox:on {
  border-color: ${accent};
}

QComboBox::drop-down {
  width: 18px;
  border: none;
}

QComboBox::down-arrow,
QComboBox::down-arrow:focus {
  image: url("${icons}/chevron-down.svg");
  width: 16px;
  height: 16px;
  margin-right: 4px;
}

QComboBox QAbstractItemView {
  color: ${text};
  background-color: ${field};
  border: 1px solid ${border};
  border-radius: 4px;
  selection-background-color: ${accent_soft};
  selection-color: ${text};
  outline: 0;
}

QPushButton {
  text-transform: none;
  font-weight: normal;
  color: ${text};
  background-color: ${field};
  border: 1px solid ${border};
  border-radius: 4px;
  padding: 2px 12px;
  min-height: 20px;
  height: 20px;
}

QPushButton:hover {
  border-color: ${muted};
  background-color: ${hover};
}

QPushButton:pressed {
  background-color: ${pressed};
}

QPushButton:focus {
  border-color: ${accent};
}

/* A button that opens a menu, as Session and Open do, with its arrow after the text. */
QToolButton#menuButton {
  color: ${text};
  background-color: ${field};
  border: 1px solid ${border};
  border-radius: 4px;
  padding: 2px 24px 2px 12px;
  min-height: 20px;
}

QToolButton#menuButton:hover {
  border-color: ${muted};
  background-color: ${hover};
}

QToolButton#menuButton:pressed {
  background-color: ${pressed};
}

QToolButton#menuButton::menu-indicator {
  image: url("${icons}/chevron-down.svg");
  subcontrol-origin: padding;
  subcontrol-position: center right;
  right: 6px;
  width: 12px;
  height: 12px;
}

QPushButton#colourField {
  font-family: "Menlo", "Consolas", "DejaVu Sans Mono", monospace;
}

QCheckBox {
  background-color: transparent;
  spacing: 6px;
  min-height: 20px;
}

QCheckBox::indicator,
QAbstractItemView::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid ${muted};
  border-radius: 4px;
  background-color: ${field};
  image: none;
}

QCheckBox::indicator:hover {
  border-color: ${text};
}

QCheckBox::indicator:checked,
QAbstractItemView::indicator:checked {
  border-color: ${accent};
  background-color: ${accent};
  image: url("${icons}/check.svg");
}

QCheckBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate {
  border-color: ${accent};
  background-color: ${accent};
  image: url("${icons}/dash.svg");
}

QCheckBox::indicator:disabled {
  border-color: ${faint};
  background-color: transparent;
}

QRadioButton {
  background-color: transparent;
  spacing: 6px;
  min-height: 20px;
}

/* A round box, ringed in the accent around a light dot when chosen. */
QRadioButton::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid ${muted};
  border-radius: 8px;
  background-color: ${field};
}

QRadioButton::indicator:hover {
  border-color: ${text};
}

QRadioButton::indicator:checked {
  width: 8px;
  height: 8px;
  border: 4px solid ${accent};
  background-color: ${on_accent};
}

QRadioButton::indicator:disabled {
  border-color: ${faint};
  background-color: transparent;
}

/* The text beside a slider; SliderField sets its width. */
SliderField QLineEdit {
  padding: 2px 4px;
}

QSlider {
  background-color: transparent;
  min-height: 20px;
}

QSlider::groove:horizontal {
  height: 4px;
  border-radius: 2px;
  background-color: ${border};
  margin: 0px;
}

QSlider::sub-page:horizontal {
  height: 4px;
  border-radius: 2px;
  background-color: ${accent};
}

QSlider::add-page:horizontal {
  height: 4px;
  border-radius: 2px;
  background-color: ${border};
}

QSlider::handle:horizontal {
  width: 12px;
  height: 12px;
  margin: -6px 0px;
  border-radius: 8px;
  background-color: ${accent};
  border: 2px solid ${field};
}

QSlider::handle:horizontal:hover {
  background-color: ${accent_light};
}

QSlider::sub-page:horizontal:disabled,
QSlider::handle:horizontal:disabled {
  background-color: ${faint};
}

/* ---- Dialogs ---- */

QDialog {
  background-color: ${window};
}

QTableView,
QTableWidget {
  color: ${text};
  background-color: ${field};
  alternate-background-color: ${bar};
  gridline-color: transparent;
  border: 1px solid ${border};
  border-radius: 4px;
  selection-background-color: ${accent_soft};
  selection-color: ${text};
}

/* The Help panel: the list of guides and the guide being read. */

QListWidget#guides {
  background-color: ${window};
  border: none;
  outline: 0;
  padding: 4px 0px;
}

QListWidget#guides::item {
  height: 26px;
  padding: 0px 8px;
  color: ${text};
}

QListWidget#guides::item:hover {
  background-color: ${hover};
}

QListWidget#guides::item:selected {
  background-color: ${accent_soft};
  color: ${text};
}

QTextBrowser#guide {
  color: ${text};
  background-color: ${field};
  border: 1px solid ${border};
  border-radius: 4px;
  padding: 8px 12px;
}

QHeaderView::section {
  color: ${muted};
  background-color: ${bar};
  border: none;
  border-bottom: 1px solid ${border};
  padding: 4px 8px;
  font-weight: bold;
  text-transform: none;
}

/* ---- Status bar and progress bar ---- */

QStatusBar {
  color: ${muted};
  background-color: ${bar};
  border-top: 1px solid ${border};
}

QStatusBar::item {
  border: none;
}

QStatusBar QLabel {
  color: ${muted};
}

QProgressBar {
  color: ${text};
  background-color: ${border};
  border: none;
  border-radius: 3px;
  max-height: 6px;
  min-width: 120px;
  text-align: center;
}

QProgressBar::chunk {
  background-color: ${accent};
  border-radius: 3px;
}

/* ---- Scroll bars ---- */

QScrollBar:vertical {
  background-color: transparent;
  width: 8px;
  border: none;
}

QScrollBar:horizontal {
  background-color: transparent;
  height: 8px;
  border: none;
}

QScrollBar::handle {
  background-color: ${border};
  border-radius: 4px;
  min-height: 24px;
  min-width: 24px;
}

QScrollBar::handle:hover {
  background-color: ${muted};
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
  background: none;
  border: none;
  width: 0px;
  height: 0px;
}

/* ---- Phantom editor: the steps and their pages ---- */

QToolButton#moreFold {
  color: ${muted};
  border: none;
  background-color: transparent;
  padding: 4px 0px 4px 10px;
  text-align: left;
}

QToolButton#moreFold:hover {
  color: ${text};
}

QFrame#drawCard {
  background-color: ${accent_faint};
  border: 1px solid ${accent};
  border-radius: 5px;
}

QWidget#stepRail {
  background-color: ${window};
}

QFrame#stepRow {
  background-color: transparent;
  border-radius: 5px;
}

QFrame#stepRow:hover {
  background-color: ${hover};
}

QFrame#stepRow[current="true"] {
  background-color: ${accent_soft};
}

QLabel#railTitle,
QLabel#stepHeading {
  color: ${text};
  font-weight: bold;
}

QLabel#stepHeading {
  font-size: 17px;
}

QLabel#stepText {
  color: ${muted};
}

QLabel#stepStatus,
QLabel#railNote {
  color: ${muted};
  font-size: 12px;
}

QPushButton#optionalStep {
  color: ${text};
  background-color: transparent;
  border: none;
  text-align: left;
  padding: 2px 10px;
}

QPushButton#optionalStep:hover {
  color: ${accent_light};
}

QWidget#stepNav {
  border-top: 1px solid ${border};
}

QPushButton#nextStep {
  color: ${on_accent};
  background-color: ${accent};
  border: none;
  font-weight: bold;
  padding: 4px 14px;
}

QPushButton#nextStep:hover {
  background-color: ${accent_light};
}
